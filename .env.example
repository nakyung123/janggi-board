# 이 파일은 '어떤 이름의 값이 필요한가' 만 적어 둔 본보기입니다.
# 실제 값은 .env.local 에 넣으세요. .env* 는 .gitignore 에 등록되어 있습니다.
#
# 비밀 정보는 아직 없습니다. 아래 둘은 주소라서 빌드에 그대로 박힙니다.

# 제보를 받을 곳(구글 폼 같은 것)의 주소. 비워 두면 제보 버튼이 아예 뜨지 않습니다.
VITE_FEEDBACK_URL=

# 폼에서 '환경' 을 받는 칸의 이름표(entry.NNN). 있으면 그 칸이 미리 채워진 채로 열립니다.
# 폼 ⋮ → 미리 채워진 링크 가져오기 → 그 칸에만 아무 글자를 넣고 받은 주소에 적혀 있습니다.
VITE_FEEDBACK_ENTRY=
